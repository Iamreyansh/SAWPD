# Copy to .env.local and fill in.

# Admin portal password (min 8 chars). Used to sign the admin session cookie.
ADMIN_SECRET=change-me-to-a-long-random-string

# Seller session signing key (min 8 chars). MUST be different from ADMIN_SECRET.
SELLER_SECRET=change-me-to-a-different-long-random-string

# Resend API key (get from https://resend.com/api-keys)
# In development, only your Resend account email can receive emails.
# In production, verify a custom domain at resend.com/domains.
RESEND_API_KEY=re_your_key_here

# Sender email address (must use a verified domain in Resend)
# Default: "SAWPD <onboarding@resend.dev>" (dev only, works out of the box)
# For production: "SAWPD <noreply@yourdomain.com>"
EMAIL_FROM=

# App URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notification email (admin inbox for application alerts)
NOTIFY_EMAIL=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
