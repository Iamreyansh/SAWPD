# Copy to .env.local and fill in.

# Admin portal password (min 8 chars). Used to sign the admin session cookie.
ADMIN_SECRET=change-me-to-a-long-random-string

# Seller session signing key (min 8 chars). MUST be different from ADMIN_SECRET.
SELLER_SECRET=change-me-to-a-different-long-random-string

# Resend API key (get from https://resend.com/api-keys)
# In development, only your Resend account email can receive emails.
# In production, verify a custom domain at resend.com/domains.
RESEND_API_KEY=re_your_key_here

# Sender email address (must use a verified domain in Resend)
# Default: "SAWPD <onboarding@resend.dev>" (dev only, works out of the box)
# For production: "SAWPD <noreply@yourdomain.com>"
EMAIL_FROM=

# App URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notification email (admin inbox for application alerts)
NOTIFY_EMAIL=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com → Turnstile)
# Optional in dev — CAPTCHA is skipped if not set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ─── Analytics & ad pixels ────────────────────────────────────────────
# All optional — pixels silently no-op when IDs are missing.

# Meta (Facebook/Instagram) Pixel — browser-side tag.
# Get from: business.facebook.com → Events Manager → your pixel → Settings.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (CAPI) — server-side events for iOS 14.5+
# attribution. Without this, ~40% of conversions are missed.
# Get from: Events Manager → your pixel → Settings → Conversions API → Generate token.
META_CAPI_ACCESS_TOKEN=

# Google Analytics 4 — free. Format: G-XXXXXXXXXX
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads — for paid search/YouTube campaigns. Format: AW-XXXXXXXXX
# Get from: ads.google.com → Tools → Conversions → Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Demo store slug used by /track's dev-only "try a demo order" helper.
# Falls back to the first store with orders if unset.
NEXT_PUBLIC_DEMO_STORE_SLUG=

# ─── Checkout OTP verification (tuktuk-style) ───────────────────
# Pick the delivery channel for the verification code sent to the
# customer's phone at checkout. OTP must be entered before payment
# options unlock. Defaults to `console` (logs the OTP + shows it on
# screen in dev) — configure one of the providers below for prod.

# OTP_PROVIDER=console         # dev default — code is logged + shown
# OTP_PROVIDER=email           # uses Resend via lib/notify (admin inbox)
# OTP_PROVIDER=fast2sms        # Indian SMS gateway (~₹0.10/code)
# OTP_PROVIDER=twilio          # Twilio WhatsApp API (international)

# Fast2SMS (https://www.fast2sms.com/dashboard)
FAST2SMS_API_KEY=

# Twilio WhatsApp (https://console.twilio.com → Account + Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
